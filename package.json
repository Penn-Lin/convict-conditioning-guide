{
  "name": "convict-conditioning-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "《囚徒健身》六艺十式动作指导站 —— 纯静态客户端 SPA",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:lock": "node scripts/check-lock.mjs",
    "build": "node scripts/check-lock.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/gen-sitemap.mjs",
    "build:sitemap": "node scripts/gen-sitemap.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "lucide-react": "^0.441.0"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.14.0",
    "vitest": "^2.1.9"
  }
}
